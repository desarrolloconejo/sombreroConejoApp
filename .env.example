# ---------------------------------------------------------------------------
# ESTE ARCHIVO CONFIGURA EL ENTORNO DE DESARROLLO, que corre en docker compose
# contra el PostgreSQL local. Produccion vive en Vercel y su configuracion se
# pone alli, no aqui: ver el bloque del final.
#
# Ambiente de ejecucion. Determina que servicio de la app levanta docker
# compose: "dev" (hot reload con bind mount, mas pgadmin) o "prod" (build
# optimizado, pensado para un VPS).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=dev

# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------
APP_PORT=3100

# Bundler del servidor de desarrollo dentro de docker.
# Turbopack no tiene modo polling y los eventos inotify no cruzan el bind
# mount de Windows a Linux, asi que en Windows el hot reload exige webpack.
# Si el proyecto vive en WSL2 o Linux nativo, usar "dev" (Turbopack, mas rapido).
DEV_SCRIPT=dev:webpack

# ---------------------------------------------------------------------------
# Base de datos
# El host "db" es el nombre del servicio dentro de la red de docker compose.
# ---------------------------------------------------------------------------
POSTGRES_USER=conejo
POSTGRES_PASSWORD=conejo_local
POSTGRES_DB=conejo_app
# Puerto expuesto en el host. Dentro de la red de docker la BD siempre es db:5432
POSTGRES_PORT=5433
DATABASE_URL=postgresql://conejo:conejo_local@db:5432/conejo_app

# ---------------------------------------------------------------------------
# pgAdmin
# El correo no puede usar TLD reservados como .local: pgAdmin los rechaza
# ---------------------------------------------------------------------------
PGADMIN_EMAIL=admin@conejo.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5051

# ---------------------------------------------------------------------------
# Sesiones
# JWT_SECRET debe tener 32 caracteres o mas. Generar uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
JWT_SECRET=cambiar-este-secreto-antes-de-produccion-min-32-chars
JWT_EXPIRACION=8h
COOKIE_SESION=conejo_sesion

# ---------------------------------------------------------------------------
# PRODUCCION — no va en este archivo, va en Vercel
# ---------------------------------------------------------------------------
# Las variables de produccion se configuran en el panel de Vercel, en
# Settings -> Environment Variables. Son solo dos obligatorias:
#
#   DATABASE_URL   la cadena AGRUPADA de Neon (su host lleva "-pooler")
#   JWT_SECRET     uno distinto al de aqui, marcado como Sensitive
#
# La cadena de Neon tiene esta forma, y el sslmode importa:
#
#   postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/BASE?sslmode=verify-full
#
# Se escribe verify-full y NO require. En pg 8.23 los dos hacen lo mismo
# —verifican la CA y el nombre del host—, pero require ademas emite un
# SECURITY WARNING en cada arranque, y en pg 9 cambiara de significado.
#
# Neon anade tambien "&channel_binding=require". Si diera guerra, se quita:
# la conexion sigue cifrada y verificada por verify-full.
#
# NO poner NODE_ENV en Vercel: lo fija la plataforma y lo rechaza a mano.
#
# La base de Neon se siembra con "npm run sql:produccion" y pegando el
# archivo resultante en el editor SQL de su panel. No se puede sembrar por
# conexion directa: ProtonVPN bloquea el puerto 5432 de salida.

# ---------------------------------------------------------------------------
# Google Drive — comprobantes de finanzas
# Cliente OAuth creado en GCP (APIs y servicios -> Credenciales), con la API
# de Drive habilitada. Los archivos se guardan en ConejoApp/Comprobantes, en
# el Drive de la cuenta que autoriza.
#
# DRIVE_REFRESH_TOKEN y DRIVE_CARPETA_COMPROBANTES_ID no se escriben a mano:
# los deja "npm run drive:probar" tras autorizar en el navegador.
# ---------------------------------------------------------------------------
DRIVE_CLIENT_ID=
SECRET_DRIVE_KEY1=
DRIVE_REFRESH_TOKEN=
DRIVE_CARPETA_COMPROBANTES_ID=
