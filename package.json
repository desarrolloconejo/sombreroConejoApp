{
  "name": "sombrero-conejo-app",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicacion web para centralizar y automatizar los procesos de El Conejo del Sombrero",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env db/seed.mts",
    "prueba:auditor": "npx tsx db/pruebas/auditor.mts",
    "prueba:modelos": "DATABASE_URL=${DATABASE_URL_ADMIN:-$DATABASE_URL} npx tsx db/pruebas/modelos.mts",
    "prueba:sesiones": "DATABASE_URL=${DATABASE_URL_ADMIN:-$DATABASE_URL} npx tsx db/pruebas/sesiones.mts",
    "prueba:permisos": "npx tsx db/pruebas/permisos.mts",
    "sql:produccion": "node db/generarSql.mts",
    "drive:probar": "node --env-file=.env scripts/driveProbar.mjs",
    "google:autorizar": "node --env-file=.env scripts/driveProbar.mjs --reautorizar",
    "drive:separar": "node --env-file=.env scripts/driveSeparar.mjs",
    "drive:limpiar": "node --env-file=.env scripts/driveLimpiar.mjs",
    "correo:probar": "node --env-file=.env scripts/correoProbar.mjs",
    "test": "playwright test",
    "test:unitarias": "playwright test --project=unitarias",
    "test:integracion": "playwright test --project=integracion"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
